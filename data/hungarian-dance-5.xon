; hungarian-dance-5.xon -- Brahms, Hungarian Dance No. 5 in G minor:
; `x -l tracker -- play data/hungarian-dance-5.xon`.
;
; The notes are from Albert Parlow's orchestration (N. Simrock, Berlin,
; 1876, plate 7727), the G minor version orchestras play.  The lead is
; the first violins, the bass the cellos and basses, the horns the
; offbeat chords; the flute doubles the lead in the tension layer, and
; the timpani and the triangle play where Parlow wrote them.  The
; cimbalom, the Hungarian hammered dulcimer, is added: it plays the
; Vivace's chords.
;
; A song has one tempo, so the score's changes of tempo are written into
; the rows, at 200 bpm and 4 rows a beat:
;   Allegro      a sixteenth 2 rows, a 2/4 bar 16 rows
;   poco rit.    a sixteenth 3 rows, a bar 24 rows
;   Vivace       an eighth 2 rows, a bar 8 rows: twice the Allegro
;   its rit.     an eighth 3 rows, then 4, slowing over two bars
; The form is the score's, with its repeats: the theme, the second strain
; twice, the Vivace, the theme again and the strain twice to the end.

(wave fiddle 12 9 7 5 4 3 3 2 2 1)
(wave horn 10 7 4 2 1)
(wave soft 8 3 1)
(wave flute 10 3 1)
(wave cimbalom 6 5 4 3 3 2 2 1 1 1)
(wave glass 5 0 0 2 0 0 0 1)

; The flute is the tension layer: at :tension 100 it doubles the lead and
; the whole dance is 40 bpm faster.
(song "hungarian-dance-5" (bpm 200) (rows 4) (ticks 3) (tension-bpm 40)
  (chorus 2 12 3 3000 22)
  (reverb 110 75 22)
  (limit 92 120)
  (instrument lead (wave fiddle) (cut 45) (env (0 0) (30 60) (250 48)) (release 140) (gain 26) (pan -10)
    (voice (detune -5)) (voice (detune 5)))
  (instrument flute (layer tension) (wave flute) (cut 60) (env (0 0) (20 40) (300 34)) (release 120) (gain 12) (pan -30))
  (instrument horn (wave horn) (cut 30) (env (0 0) (8 55) (160 30)) (release 60) (gain 13) (pan 25))
  (instrument bass (wave soft) (cut 30) (env (0 0) (6 85) (200 55)) (release 70) (gain 44))
  (instrument cimb (wave cimbalom) (cut 70) (env (0 0) (2 45) (500 0)) (release 200) (gain 13) (pan 35))
  (instrument timp (wave sine) (env (0 0) (3 90) (600 0)) (bend (0 40) (60 0)) (release 300) (gain 40))
  (instrument tri (wave glass) (note "E7") (env (0 0) (1 30) (900 0)) (release 400) (gain 10) (pan -40))
  (pattern theme
    (lead   "D4 . . . ./v15,7 . . . . . . . G4/p2 . . . Bb4 . . . . . . . . . . . G4 . . . F#4 . . . . . . . . . . . G4 . A4 . G4 . . . ./v20,6 . . . . . . . . . . . Eb4 . . . . . . . . . . . F4 . G4 . D4 . . . ./v20,6 . . . . . . . . . . . C4 . Bb3 . . . A3 . . . . . . . D4 . G3 . . . ./v15,7 . . . . . . . . . . .")
