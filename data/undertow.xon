; undertow.xon -- an original drum and bass tune in D minor:
; `x -l tracker -- play data/undertow.xon`.
;
; 174 bpm, 4 rows a beat: a row is a sixteenth, a pattern two bars of
; 4/4.  Each pattern is two chords of a four-chord turn, Dm Bb in the
; first and Gm A in the next.  The form, eighteen patterns, none played
; twice:
;   intro, haze      the pads and the hook on the bell, the reese dark
;   rise, lift       the build: kicks, snare rolls, the riser climbs
;   drop .. roll     drop 1: the two-step, the sub and the reese, the hook
;                    and the stabs that answer it
;   fall, hush       the breakdown: the hook sung half time on the vox
;   climb, edge      the build again, the rolls faster
;   return .. crest  drop 2: the hook again, a bell a third above, the
;                    reese sliding, the vox doubling it an octave down
;   ebb, last        the outro, everything fading
;
; The hook is the same two bars in every drop, its echo the song's echo
; three rows long and the bell playing it again a row behind.

; The pad and the vox are a wave of uneven harmonics, the bell a glass;
; the reese's third voice is a drawn wave, rough at its jumps.
(wave choir 6 3 4 1 2 0 1)
(wave glass 5 0 0 2 0 0 0 1)
(wave rasp (0 -100) (4 100) (4 0) (6 60) (8 -100))

; The arp, the riser, the whoosh and the tick are the tension layer: at
; :tension 100 they drive and the tune is 8 bpm faster.  The pad is the
; calm layer.
(song "undertow" (bpm 174) (rows 4) (ticks 6) (tension-bpm 8)
  (chorus 2 12 3 3000 18)
  (drive 170 32)
  (sweep 2500 6300 11034 18)
  (crush 11 22050)
  (echo 259 38 20)
  (reverb 100 70 16)
  (limit 90 100)
  (instrument kick (wave sine) (note "C2") (env (0 0) (1 98) (40 70) (130 0)) (bend (0 1000) (30 0)) (release 25) (gain 66))
  (instrument snare (env (0 0) (1 70) (25 32) (150 0)) (release 40) (gain 42)
    (voice (wave noise) (hz 1) (cut 62)) (voice (wave triangle) (note "A3") (bend (0 300) (20 0)) (gain 45)))
  (instrument hat (wave noise) (hz 1) (cut 92) (env (0 0) (1 26) (28 0)) (release 12) (gain 14) (pan 28))
  (instrument ohat (wave noise) (hz 1) (cut 82) (env (0 0) (1 22) (170 0)) (release 60) (gain 11) (pan -22))
  (instrument tick (layer tension) (wave metal) (hz 5200) (cut 90) (env (0 0) (1 20) (22 0)) (release 10) (gain 10) (pan 45))
  (instrument sub (wave sine) (env (0 0) (4 92) (300 78)) (release 60) (gain 46))
  (instrument reese (cut 34) (env (0 0) (8 75) (400 60)) (release 70) (gain 20)
    (voice (wave saw) (detune -16) (pan -35))
    (voice (wave saw) (detune 16) (pan 35))
    (voice (wave pulse) (width (0 20) (700 50) (1400 20)) (gain 60))
    (voice (wave rasp) (detune 5) (gain 45)))
  (instrument lead (cut 48) (env (0 0) (6 62) (220 46)) (release 180) (gain 20) (pan -12)
    (voice (wave pulse) (width (0 18) (500 42)) (detune -6))
    (voice (wave saw) (detune 6) (cut 40)))
  (instrument bell (wave glass) (env (0 0) (2 40) (900 0)) (release 500) (gain 15) (pan 30))
  (instrument stab (wave saw) (cut 50) (env (0 0) (2 70) (140 8)) (release 60) (gain 14)
    (voice (detune -10) (pan -45)) (voice (detune 10) (pan 45)))
  (instrument vox (wave choir) (cut 36) (env (0 0) (70 48) (700 38)) (release 420) (gain 17) (pan -20)
    (voice (detune -8)) (voice (detune 8) (wave triangle) (gain 70)))
  (instrument pad (layer calm) (wave choir) (cut 22) (env (0 0) (500 30) (2500 24)) (release 1000) (gain 14)
    (voice (detune -9) (pan -55)) (voice (detune 9) (pan 55)))
  (instrument arp (layer tension) (wave pulse) (width (0 12) (300 35)) (cut 45) (env (0 0) (2 45) (110 0)) (release 30) (gain 11) (pan -38))
  (instrument riser (layer tension) (cut 30) (env (0 0) (2000 45)) (release 80) (gain 10)
    (voice (wave saw) (detune -20) (pan -40)) (voice (wave saw) (detune 20) (pan 40)))
  (instrument whoosh (layer tension) (wave noise) (hz 1) (cut 70) (env (0 0) (2500 30)) (release 60) (gain 10))

  ; the intro: the chords, the hook glimpsed on the bell
  (pattern intro
    (pad   "A3 . . . . . . . . . . . . . . .  Bb3 . . . . . . . . . . . . . . .")
    (pad   "D4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (pad   "F4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (bell  "A5:60 . . D6:60 . . C6:60 . A5:60 . . . . . . .  . . . . . . . . . . . . . . . .")
    (hat   ". . . . . . . . . . . . . . C4:50 .  . . . . . . C4:50 . . . . . . . C4:50/r2 ."))
  (pattern haze
    (pad   "Bb3 . . . . . . . . . . . . . . .  A3 . . . . . . . . . . . . . . .")
    (pad   "D4 . . . . . . . . . . . . . . .  C#4 . . . . . . . . . . . . . . .")
    (pad   "G4 . . . . . . . . . . . . . . .  E4 . . . . . . . . . . . . . . .")
    (bell  "A5:60 . . D6:60 . . C6:60 . A5:60 . . . Bb5:60 . A5:60 .  G5:60 . . . E5:50 . . . . . . . . . . .")
    (reese "G2:60/l15 . . . . . . . . . . . . . . .  A2:60/l15 . . . . . . . . . . ./l60 . . . .")
    (hat   "C4 . C4:60 . C4 . C4:60/d3 . C4 . C4:60 . C4 . C4:60/d3 .  C4 . C4:60 . C4 . C4:60/d3 . C4 . C4:60 . C4 . C4:60/d3 ."))

  ; the build: a kick on the bar, the riser up a fifth, then an octave
  (pattern rise
    (kick   "C4 . . . . . . . . . . . . . . .  C4 . . . . . . . . . . . . . . .")
    (snare  ". . . . C4 . . . . . . . C4 . . .  . . . . C4 . . . . . . . C4 . . .")
    (hat    "C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3  C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3")
    (sub    "D2 . . . . . . . . . . . . . . .  Bb1 . . . . . . . . . . . . . . .")
    (reese  "D3/l20 . . . . . . ./l50 . . . . . . . .  Bb2/l50 . . . . . . . . . . . . . . .")
    (pad    "A3 . . . . . . . . . . . . . . .  Bb3 . . . . . . . . . . . . . . .")
    (pad    "D4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (pad    "F4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (stab   ". . . . . . . . . . . . . . . .  . . . . . . . . F4/c3 . . F4/c3 . . . .")
    (stab   ". . . . . . . . . . . . . . . .  . . . . . . . . Bb4/c3 . . Bb4/c3 . . . .")
    (arp    "D5 A4 F5 A4 D5 A4 F5 A4 D5 A4 F5 A4 D5 A4 F5 A4  D5 Bb4 F5 Bb4 D5 Bb4 F5 Bb4 D5 Bb4 F5 Bb4 D5 Bb4 F5 Bb4")
    (riser  "D3/s700 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (whoosh "C4/l5 ./l100 . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . ."))
  (pattern lift
    (kick   "C4 . . . . . . . C4 . . . . . . .  C4 . . . C4 . . . C4 . C4 . C4 C4 C4 -")
    (snare  ". . . . C4 . . . . . . . C4 . . C4:50  C4/r3 . . . C4/r2 . . . C4/r1 . . . . . . -")
    (hat    "C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3  C4/r2 . . . . . . . . . . . . . . -")
    (sub    "G1 . . . . . . . . . . . . . . .  A1 . . . . . . ./s1200 . . . . . . . -")
    (reese  "G2/l30 . . . . . . ./l80 . . . . . . . .  A2/l40 . . . ./l100 . . . . . . . . . . -")
    (pad    "Bb3 . . . . . . . . . . . . . . .  A3 . . . . . . . . . . . . . . -")
    (pad    "D4 . . . . . . . . . . . . . . .  C#4 . . . . . . . . . . . . . . -")
    (pad    "G4 . . . . . . . . . . . . . . .  E4 . . . . . . . . . . . . . . -")
    (stab   ". . . . . . . . . . . . . . . .  . . . . . . . . E4/c3 . E4/c3 . E4/c3 . . .")
    (stab   ". . . . . . . . . . . . . . . .  . . . . . . . . A4/c3 . A4/c3 . A4/c3 . . .")
    (arp    "D5 Bb4 G5 Bb4 D5 Bb4 G5 Bb4 D5 Bb4 G5 Bb4 D5 Bb4 G5 Bb4  E5 C#5 A5 C#5 E5 C#5 A5 C#5 E5 C#5 A5 C#5 E5 C#5 A5 -")
    (riser  "G3/s1200 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . -")
    (whoosh "C4/l5 ./l100 . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . -"))

  ; drop 1: the hook calls, the stabs answer
  (pattern drop
    (kick  "C4 . . . . . . . . . C4 . . . . .  C4 . . . . . . . . . C4 . . . . .")
    (snare ". . . . C4 . . C4:30 . C4:25 . . C4 . . .  . . . . C4 . . C4:30 . C4:25 . . C4 . . .")
    (hat   "C4 . C4:60 . C4 . C4:60/d3 . C4 . C4:60 . C4 . C4:60/d3 .  C4 . C4:60 . C4 . C4:60/d3 . C4 . C4:60 . C4 . C4:60/d3 .")
    (ohat  ". . . . . . C4 . . . . . . . C4 .  . . . . . . C4 . . . . . . . C4 .")
    (tick  "C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40  C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40")
    (sub   "D2 . . . . . . . . . D2 . . . . .  Bb1 . . . . . . . . . Bb1 . . . C2/p2 .")
    (reese "D3/l30 . . ./l90 . . ./l25 . . D3/l60 . . . F3/p2 . .  Bb2/l30 . . ./l90 . . ./l25 . . Bb2/l60 . . . C3/p2 . .")
    (lead  "A4 . . D5 . . C5 . A4 . . . F4 . G4 .  F4 . . . D4 . ./v20,6 . - . . . . . . .")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . F4/c3 . . F4/c3 . . F4/c3 .")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . Bb4/c3 . . Bb4/c3 . . Bb4/c3 .")
    (pad   "A3 . . . . . . . . . . . . . . .  Bb3 . . . . . . . . . . . . . . .")
    (pad   "D4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (pad   "F4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . ."))
  (pattern turn
    (kick  "C4 . . . . . . . . . C4 . . . . .  C4 . . . . . . . . . C4 . . . C4:70 .")
    (snare ". . . . C4 . . C4:30 . C4:25 . . C4 . . .  . . . . C4 . . . . . C4:30 . C4 . . C4:35/d3")
    (hat   "C4 . C4:60 . C4 . C4:60/d3 . C4 . C4:60 . C4 . C4:60/d3 .  C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3")
    (ohat  ". . . . . . C4 . . . . . . . C4 .  . . . . . . C4 . . . . . . . C4 .")
    (tick  "C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40  C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40")
    (sub   "G1 . . . . . . . . . G1 . . . . .  A1 . . . . . . . . . A1 . . . . .")
    (reese "G2/l30 . . ./l90 . . ./l25 . . G2/l60 . . . Bb2/p2 . .  A2/l30 . . ./l90 . . ./l25 . . A2/s-100 . . ./s100 E3/p2 . .")
    (lead  "A4 . . D5 . . C5 . A4 . . . Bb4 . A4 .  G4 . . . E4 . ./v20,6 . - . . . . . . .")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . E4/c3 . E4/c3 . . E4/c3 . E4/c2")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . A4/c3 . A4/c3 . . A4/c3 . A4/c2")
    (arp   "G5 . D5 . Bb5 . D5 . G5 . D5 . Bb5 . D5 .  A5 . E5 . C#6 . E5 . A5 . E5 . C#6 . E5 .")
    (pad   "Bb3 . . . . . . . . . . . . . . .  A3 . . . . . . . . . . . . . . .")
    (pad   "D4 . . . . . . . . . . . . . . .  C#4 . . . . . . . . . . . . . . .")
    (pad   "G4 . . . . . . . . . . . . . . .  E4 . . . . . . . . . . . . . . ."))
  (pattern echo
    (kick  "C4 . . . . . C4:80 . . . C4 . . . . .  C4 . . . . . . . . . C4 . . . . .")
    (snare ". . . . C4 . . . . . C4:30 . C4 . . C4:35/d3  . C4:25 . . C4 . . C4:30 . . . C4:25 C4 . C4:30 .")
    (hat   "C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3  C4 . C4:60 . C4 . C4:60/d3 . C4 . C4:60 . C4 . C4:60/d3 .")
    (ohat  ". . . . . . C4 . . . . . . . C4 .  . . . . . . C4 . . . . . . . C4 .")
    (tick  "C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40  C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40")
    (sub   "D2 . . . . . . . . . D2 . . . . .  Bb1 . . . . . . . . . Bb1 . . . C2/p2 .")
    (reese "D3/l20 ./l100 D3/c3 . D3/l40 . ./s200 . ./s-200 . D3/l70 . C3/p2 . D3/p2 .  Bb2/l20 ./l100 Bb2/c3 . Bb2/l40 . ./s-200 . ./s200 . Bb2/l70 . A2/p2 . C3/p2 .")
    (lead  "A4 . . D5 . . C5 . A4 . . . F4 . G4 .  F4 . . . D4 . ./v20,6 . - . . . . . . .")
    (bell  ". A5:45 . . D6:45 . . C6:45 . A5:45 . . . F5:45 . G5:45  . F5:45 . . . D5:45 . . . . . . . . . .")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . F4/c3 . F4/c3 . . F4/c3 F4/c2 .")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . Bb4/c3 . Bb4/c3 . . Bb4/c3 Bb4/c2 .")
    (pad   "A3 . . . . . . . . . . . . . . .  Bb3 . . . . . . . . . . . . . . .")
    (pad   "D4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (pad   "F4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . ."))
  (pattern roll
    (kick  "C4 . . . . . . . . . C4 . . . . .  C4 . . . . . . . . . C4 . . . C4:70 .")
    (snare ". . . . C4 . . C4:30 . C4:25 . . C4 . . .  . . . . C4 . . C4:30 C4/r3 . . . C4/r2 . C4/r1 .")
    (hat   "C4 . C4:60 . C4 . C4:60/d3 . C4 . C4:60 . C4 . C4:60/d3 .  C4 C4 C4 C4 C4 C4:60 C4 C4:60 C4/r2 . . . C4/r1 . . .")
    (tick  "C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40  C4/r1 . . . . . . . . . . . . . . .")
    (sub   "G1 . . . . . . . . . G1 . . . . .  A1 . . . . . . . A1/s1200 . . . . . . -")
    (reese "G2/l20 ./l100 G2/c3 . G2/l40 . ./s300 . ./s-300 . G2/l70 . F2/p2 . G2/p2 .  A2/l20 ./l100 A2/c3 . A2/l40 . . . A2/s1200 . . . . . . -")
    (lead  "A4 . . D5 . . C5 . A4 . . . Bb4 . A4 .  G4 . . . A4/p2 . . . . . ./v25,5 . . . . -")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . E4/c3 E4/c3 . . E4/c2 E4/c2 . -")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . A4/c3 A4/c3 . . A4/c2 A4/c2 . -")
    (arp   "G5 . D5 . Bb5 . D5 . G5 . D5 . Bb5 . D5 .  A4/a4,7,12 . . . . . . . . . . . . . . -")
    (riser "G3/s1200 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . -")
    (pad   "Bb3 . . . . . . . . . . . . . . .  A3 . . . . . . . . . . . . . . .")
    (pad   "D4 . . . . . . . . . . . . . . .  C#4 . . . . . . . . . . . . . . .")
    (pad   "G4 . . . . . . . . . . . . . . .  E4 . . . . . . . . . . . . . . ."))

  ; the breakdown: the drums gone, the hook sung half time
  (pattern fall
    (hat   ". . C4:40 . . . C4:40 . . . C4:40 . . . C4:40 .  . . C4:40 . . . C4:40 . . . C4:40 . . . C4:40 .")
    (sub   "D2 . . . . . . . . . . . . . . .  Bb1 . . . . . . . . . . . . . . .")
    (reese "D3:50/l10 . . . . . . . . . . . . . . .  Bb2:50/l10 . . . . . . . ./l40 . . . . . . .")
    (vox   "A4 . . . . . D5 . . . . . C5 . . .  A4 . . . . . . . F4 . . . G4 . . .")
    (bell  ". . . . . . . . . . . . . . . .  . . . . . . . . A5:50 . . D6:50 . . C6:50 .")
    (pad   "A3 . . . . . . . . . . . . . . .  Bb3 . . . . . . . . . . . . . . .")
    (pad   "D4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (pad   "F4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . ."))
  (pattern hush
    (kick  "C4:70 . . . . . . . . . . . . . . .  . . . . . . . . C4:60 . . . . . . .")
    (snare ". . . . . . . . . . . . . . . .  . . . . . . . . C4:60 . . . . . . .")
    (hat   ". . C4:40 . . . C4:40 . . . C4:40 . . . C4:40 .  . . C4:40 . . . C4:40 . . . C4:40 . . . C4:40 .")
    (sub   "G1 . . . . . . . . . . . . . . .  A1 . . . . . . . . . . . . . . .")
    (reese "G2:50/l10 . . . . . . . . . . . . . . .  A2:50/l10 . . . . . . . ./l50 . . . . . . .")
    (vox   "A4 . . . . . D5 . . . . . C5 . . .  A4 . . . . . . . G4 . . . E4/v20,6 . . .")
    (bell  ". . . . . . . . . . . . . . . .  . . . . . . . . A5:50 . . D6:50 . . C6:50 .")
    (riser "G2/s1200 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (pad   "Bb3 . . . . . . . . . . . . . . .  A3 . . . . . . . . . . . . . . .")
    (pad   "D4 . . . . . . . . . . . . . . .  C#4 . . . . . . . . . . . . . . .")
    (pad   "G4 . . . . . . . . . . . . . . .  E4 . . . . . . . . . . . . . . ."))

  ; the build again, its snare doubling and rolling faster
  (pattern climb
    (kick   "C4 . . . . . . . C4 . . . . . . .  C4 . . . . . . . C4 . . . . . . .")
    (snare  ". . . . C4 . . . . . . . C4 . . .  C4:60 . C4:60 . C4:70 . C4:70 . C4:80 . C4:80 . C4 . C4 .")
    (hat    "C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3  C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3")
    (sub    "D2 . . . . . . . . . . . . . . .  Bb1 . . . . . . . . . . . . . . .")
    (reese  "D3/l20 . . . . . . ./l60 . . . . . . . .  Bb2/l30 . . . . . . ./l70 . . . . . . . .")
    (lead   "A4:60 . . D5:60 . . C5:60 . A4:60 . . . F4:60 . G4:60 .  . . . . . . . . . . . . . . . .")
    (stab   ". . . . . . . . . . . . . . . .  . . . . . . . . F4/c3 . . F4/c3 . . F4/c3 .")
    (stab   ". . . . . . . . . . . . . . . .  . . . . . . . . Bb4/c3 . . Bb4/c3 . . Bb4/c3 .")
    (pad    "A3 . . . . . . . . . . . . . . .  Bb3 . . . . . . . . . . . . . . .")
    (pad    "D4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (pad    "F4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (arp    "D5 A4 F5 A4 D5 A4 F5 A4 D5 A4 F5 A4 D5 A4 F5 A4  D5 Bb4 F5 Bb4 D5 Bb4 F5 Bb4 D5 Bb4 F5 Bb4 D5 Bb4 F5 Bb4")
    (riser  "D3/s700 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (whoosh "C4/l5 ./l100 . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . ."))
  (pattern edge
    (kick   "C4 . . . C4 . . . C4 . . . C4 . . .  C4 . C4 . C4 . C4 . C4 C4 C4 C4 C4 C4 C4 -")
    (snare  "C4:70/r3 . . . C4:80/r3 . . . C4/r2 . . . C4/r2 . . .  C4/r1 . . . . . . . . . . . . . . -")
    (hat    "C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3  C4/r1 . . . . . . . . . . . . . . -")
    (sub    "G1 . . . . . . . . . . . . . . .  A1 . . . . . . ./s1200 . . . . . . . -")
    (reese  "G2/l30 . . ./l100 . . . . . . . . . . . .  A2/s1200 . . . . . . . . . . . . . . -")
    (lead   ". . . . . . . . . . . . . . . .  . . . . . . . . . . . . E5:50 D5:50 C#5:50 -")
    (pad    "Bb3 . . . . . . . . . . . . . . .  A3 . . . . . . . . . . . . . . -")
    (pad    "D4 . . . . . . . . . . . . . . .  C#4 . . . . . . . . . . . . . . -")
    (pad    "G4 . . . . . . . . . . . . . . .  E4 . . . . . . . . . . . . . . -")
    (arp    "D5 Bb4 G5 Bb4 D5 Bb4 G5 Bb4 D5 Bb4 G5 Bb4 D5 Bb4 G5 Bb4  E5 C#5 A5 C#5 E5 C#5 A5 C#5 E5 C#5 A5 C#5 E5 C#5 A5 -")
    (riser  "G3/s1200 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . -")
    (whoosh "C4/l5 ./l100 . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . -"))

  ; drop 2: the hook again, a bell a third above it, the reese moving
  (pattern return
    (kick  "C4 . . . . . C4:80 . . . C4 . . . . .  C4 . . . . . . . . . C4 . . . C4:70 .")
    (snare ". C4:25 . . C4 . . C4:30 . . . C4:25 C4 . C4:30 .  . . . . C4 . . C4:30 . C4:25 . . C4 . . .")
    (hat   "C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3  C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3")
    (ohat  ". . . . . . C4 . . . . . . . C4 .  . . . . . . C4 . . . . . . . C4 .")
    (tick  "C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40  C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40")
    (sub   "D2 . . . . . . . . . D2 . . . . .  Bb1 . . . . . . . . . Bb1 . . . C2/p2 .")
    (reese "D3/l20 ./l100 D3/c3 . D3/l40 . ./s200 . ./s-200 . D3/l70 . C3/p2 . D3/p2 .  Bb2/l20 ./l100 Bb2/c3 . Bb2/l40 . ./s-200 . ./s200 . Bb2/l70 . A2/p2 . C3/p2 .")
    (lead  "A4 . . D5 . . C5 . A4 . . . F5/p3 . E5 .  D5 . . . A4 . ./v20,6 . - . . . . . . .")
    (bell  "C5:70 . . F5:70 . . E5:70 . C5:70 . . . A5:70 . G5:70 .  . D6:40 . . . A5:40 . . . . . . . . . .")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . F4/c3 . . F4/c3 . . F4/c3 .")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . Bb4/c3 . . Bb4/c3 . . Bb4/c3 .")
    (pad   "A3 . . . . . . . . . . . . . . .  Bb3 . . . . . . . . . . . . . . .")
    (pad   "D4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (pad   "F4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . ."))
  (pattern answer
    (kick  "C4 . . . . . . . . . C4 . . . . .  C4 . . . . . . . . . C4 . . . C4:70 .")
    (snare ". . . . C4 . . . . . C4:30 . C4 . . C4:35/d3  . C4:25 . . C4 . . C4:30 . . . C4:25 C4 . C4:30 .")
    (hat   "C4 . C4:60 . C4 . C4:60/d3 . C4 . C4:60 . C4 . C4:60/d3 .  C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3")
    (ohat  ". . . . . . C4 . . . . . . . C4 .  . . . . . . C4 . . . . . . . C4 .")
    (tick  "C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40  C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40")
    (sub   "G1 . . . . . . . . . G1 . . . . .  A1 . . . . . . . . . A1 . . . . .")
    (reese "G2/l20 ./l100 G2/c3 . G2/l40 . ./s300 . ./s-300 . G2/l70 . F2/p2 . G2/p2 .  A2/l20 ./l100 A2/c3 . A2/l40 . ./s-1200 . . . A2/l70/p3 . . . E2/p2 .")
    (lead  "A4 . . D5 . . C5 . A4 . . . Bb4 . A4 .  G4 . . . E4/p2 . ./v20,6 . - . . . . . . .")
    (bell  "C5:70 . . F5:70 . . E5:70 . C5:70 . . . D5:70 . C5:70 .  . . . . . . . . . . . . . . . .")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . E4/c3 . E4/c3 . . E4/c3 . E4/c2")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . A4/c3 . A4/c3 . . A4/c3 . A4/c2")
    (arp   "G5 . D5 . Bb5 . D5 . G5 . D5 . Bb5 . D5 .  A5 . E5 . C#6 . E5 . A5 . E5 . C#6 . E5 .")
    (pad   "Bb3 . . . . . . . . . . . . . . .  A3 . . . . . . . . . . . . . . .")
    (pad   "D4 . . . . . . . . . . . . . . .  C#4 . . . . . . . . . . . . . . .")
    (pad   "G4 . . . . . . . . . . . . . . .  E4 . . . . . . . . . . . . . . ."))
  (pattern stack
    (kick  "C4 . . . . . . . . . C4 . . . . .  C4 . . . . . C4:80 . . . C4 . . . . .")
    (snare ". . . . C4 . . C4:30 . C4:25 . . C4 . . .  . . . . C4 . . . . . C4:30 . C4 . . C4:35/d3")
    (hat   "C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3  C4 . C4:60 . C4 . C4:60/d3 . C4 . C4:60 . C4 . C4:60/d3 .")
    (ohat  ". . . . . . C4 . . . . . . . C4 .  . . . . . . C4 . . . . . . . C4 .")
    (tick  "C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40  C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40")
    (sub   "D2 . . . . . . . . . D2 . . . . .  Bb1 . . . . . . . . . Bb1 . . . C2/p2 .")
    (reese "D3/l30 . . ./l90 . . ./l25 . . D3/l60 . . . F3/p2 . .  Bb2/l20 ./l100 Bb2/c3 . Bb2/l40 . ./s-200 . ./s200 . Bb2/l70 . A2/p2 . C3/p2 .")
    (lead  "A4 . . D5 . . C5 . A4 . . . F4 . G4 .  F4 . . . D4 . ./v20,6 . - . . . . . . .")
    (vox   "A3:60 . . D4:60 . . C4:60 . A3:60 . . . F3:60 . G3:60 .  F3:60 . . . D3:60 . . . - . . . . . . .")
    (bell  ". A5:45 . . D6:45 . . C6:45 . A5:45 . . . F5:45 . G5:45  . F5:45 . . . D5:45 . . . . . . . . . .")
    (stab  ". . F4:50/c2 . . . . . . . F4:50/c2 . . . . .  . . . . . . . . F4/c3 . . F4/c3 . . F4/c3 .")
    (stab  ". . A4:50/c2 . . . . . . . A4:50/c2 . . . . .  . . . . . . . . Bb4/c3 . . Bb4/c3 . . Bb4/c3 .")
    (arp   "D5 A4 F5 A4 D5 A4 F5 A4 D5 A4 F5 A4 D5 A4 F5 A4  D5 Bb4 F5 Bb4 D5 Bb4 F5 Bb4 D5 Bb4 F5 Bb4 D5 Bb4 F5 Bb4")
    (pad   "A3 . . . . . . . . . . . . . . .  Bb3 . . . . . . . . . . . . . . .")
    (pad   "D4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (pad   "F4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . ."))
  (pattern crest
    (kick  "C4 . . . . . . . . . C4 . . . . .  C4 . . . . . . . C4 . C4 . C4 C4 C4 -")
    (snare ". C4:25 . . C4 . . C4:30 . . . C4:25 C4 . C4:30 .  . . . . C4 . C4:40/r2 . C4/r3 . C4/r2 . C4/r1 . . -")
    (hat   "C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3 C4 C4:40 C4:70 C4:40/d3  C4 C4 C4 C4 C4 C4 C4 C4 C4/r2 . . . C4/r1 . . -")
    (tick  "C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40 C4 C4:40 C4:70 C4:40  C4/r1 . . . . . . . . . . . . . . -")
    (sub   "G1 . . . . . . . . . G1 . . . . .  A1 . . . . . . . . . . . . . . -")
    (reese "G2/l20 ./l100 G2/c3 . G2/l40 . ./s300 . ./s-300 . G2/l70 . F2/p2 . G2/p2 .  A2/l20 ./l100 A2/c3 . A2/l40 . . . A2/s-1200 . . . . . . -")
    (lead  "A4 . . D5 . . C5 . A4 . . . Bb4 . A4 .  G4 . . . A4/p2 . . . . . ./v25,5 . . . . -")
    (vox   "A3:60 . . D4:60 . . C4:60 . A3:60 . . . Bb3:60 . A3:60 .  G3:60 . . . A3:60 . . . . . . . . . . -")
    (bell  "C5:70 . . F5:70 . . E5:70 . C5:70 . . . D5:70 . C5:70 .  . . . . . . . . . . . . . . . .")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . E4/c3 E4/c3 . . E4/c2 E4/c2 . -")
    (stab  ". . . . . . . . . . . . . . . .  . . . . . . . . A4/c3 A4/c3 . . A4/c2 A4/c2 . -")
    (arp   "G5 . D5 . Bb5 . D5 . G5 . D5 . Bb5 . D5 .  A4/a4,7,12 . . . . . . . . . . . . . . -")
    (riser "G3/s1200 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . -")
    (pad   "Bb3 . . . . . . . . . . . . . . .  A3 . . . . . . . . . . . . . . .")
    (pad   "D4 . . . . . . . . . . . . . . .  C#4 . . . . . . . . . . . . . . .")
    (pad   "G4 . . . . . . . . . . . . . . .  E4 . . . . . . . . . . . . . . ."))

  ; the outro: the beat thins, the hook goes back to the bell and fades
  (pattern ebb
    (kick  "C4:80 . . . . . . . . . C4:80 . . . . .  C4:70 . . . . . . . . . . . . . . .")
    (hat   "C4 . C4:60 . C4 . C4:60/d3 . C4 . C4:60 . C4 . C4:60/d3 .  . . C4:40 . . . C4:40 . . . C4:40 . . . C4:40 .")
    (sub   "D2 . . . . . . . . . D2 . . . . .  Bb1 . . . . . . . . . . . . . . .")
    (reese "D3:60/l40 . . . . . . . ./l10 . . . . . . .  Bb2:50/l10 . . . . . . . . . . . . . . .")
    (bell  "A5:60 . . D6:60 . . C6:60 . A5:60 . . . F5:50 . G5:50 .  F5:40 . . . D5:40/f0 . . . . . . . . . . .")
    (pad   "A3 . . . . . . . . . . . . . . .  Bb3 . . . . . . . . . . . . . . .")
    (pad   "D4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (pad   "F4 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . ."))
  (pattern last
    (kick  "C4:70 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (sub   "D2/f0 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . -")
    (reese "D3:40/l5 . . . . . . . ./f0 . . . . . . .  . . . . . . . . . . . . . . . -")
    (bell  "A5:40 . . D6:30 . . C6:20 . A5:15 . . . . . . .  . . . . . . . . . . . . . . . .")
    (pad   "A3/f0 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (pad   "D4/f0 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . .")
    (pad   "F4:80/f0 . . . . . . . . . . . . . . .  . . . . . . . . . . . . . . . ."))
  (order intro haze rise lift drop turn echo roll fall hush climb edge return answer stack crest ebb last))
