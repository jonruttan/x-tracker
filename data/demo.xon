; demo.xon -- a song to start from: `x -l tracker -- data/demo.xon`.
;
; A file of songs is any number of (song ...) forms, as x/audio/tracker
; reads them, and the (wave NAME AMP ...) forms their instruments name:
; each a wave made of harmonics, the fundamental's amplitude first.

(wave organ 6 0 3 0 2 0 1)
(wave reedy 6 4 3 2 1 1)
(wave soft 8 3 1)
(wave bright 12 6 4 3 2 2 1 1)
(wave glass 5 0 0 2 0 0 0 1)

; D minor, a walking bass under a reed's tune; the bells come in as the
; tension rises (:tension 80 in the editor).
(song "lantern" (bpm 96) (rows 4) (ticks 6) (tension-bpm 30)
  (reverb 90 70 22)
  (instrument bass (wave soft) (cut 30) (env (0 0) (8 80) (220 50) (600 30)) (release 120) (gain 55))
  (instrument reed (wave reedy) (cut 45) (env (0 0) (20 60) (400 45)) (release 220) (gain 34) (pan 20))
  (instrument chord (wave organ) (cut 20) (env (0 0) (300 26) (2000 22)) (release 900) (gain 22)
    (voice (detune -6) (pan -50)) (voice (detune 6) (pan 50)))
  (instrument kick (wave sine) (note "C2") (env (0 0) (2 95) (120 0)) (bend (0 600) (40 0)) (release 30) (gain 60))
  (instrument hat (wave noise) (hz 1) (cut 80) (env (0 0) (1 30) (40 0)) (release 20) (gain 18) (pan -30))
  (instrument bell (layer tension) (wave organ) (env (0 0) (4 40) (900 0)) (release 600) (gain 20) (pan -20))
  (pattern intro
    (bass  "D2 .  .  .  A2 .  .  .  D2 .  .  .  A2 .  C3 .")
    (chord "D4 .  .  .  .  .  .  .  F4 .  .  .  .  .  .  .")
    (kick  "C2 .  .  .  .  .  .  .  C2 .  .  .  .  .  .  .")
    (hat   ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  .  C4 C4"))
  (pattern tune
    (bass  "D2 .  F2 .  A2 .  F2 .  Bb1 . D2 .  F2 .  A2 .")
    (reed  "A4 .  .  F4 G4 .  A4 .  Bb4 . .  A4 G4/v20,6 . . .")
    (chord "D4 .  .  .  .  .  .  .  Bb3 . .  .  .  .  .  .")
    (kick  "C2 .  .  .  C2 .  .  .  C2 .  .  .  C2 .  .  .")
    (hat   ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  .  C4 C4")
    (bell  "D5 .  .  .  .  .  .  .  F5 .  .  .  .  .  .  ."))
  (pattern turn
    (bass  "C2 .  E2 .  G2 .  E2 .  A1 .  C#2 . E2 . A2 .")
    (reed  "G4 .  .  E4 F4 .  G4 .  A4/s-100 . . . E4 . C#4 .")
    (chord "C4 .  .  .  .  .  .  .  A3 .  .  .  .  .  .  .")
    (kick  "C2 .  .  .  C2 .  .  .  C2 .  .  .  C2 .  C2 .")
    (hat   ".  .  C4 .  .  .  C4 .  .  .  C4 .  C4 C4 C4 C4")
    (bell  "C5 .  .  .  .  .  .  .  E5 .  .  .  .  .  .  ."))
  (order intro tune turn tune turn))

; A minor, a light on a headland: every cell effect and every song effect
; at work.  The pad is the calm layer; the strings and the bell are the
; tension layer, and come in as the tension rises (:tension 60 in the
; editor), the tempo with them.  docs/writing.md says how it is made.
(song "lighthouse" (bpm 96) (rows 4) (ticks 6) (tension-bpm 24)
  (chorus 2 14 3 4000 20)
  (phase 1 3 6000 20 16)
  (drive 140 25)
  (sweep 2000 6000 12000 15)
  (crush 13 0)
  (echo 312 30 16)
  (reverb 110 72 20)
  (limit 92 120)
  (instrument kick (wave sine) (note "C2") (env (0 0) (2 95) (140 0)) (bend (0 700) (45 0)) (release 30) (gain 62))
  (instrument snare (env (0 0) (1 60) (30 25) (160 0)) (release 40) (gain 34)
    (voice (wave noise) (hz 1) (cut 55)) (voice (wave sine) (note "G3") (gain 50)))
  (instrument hat (wave noise) (hz 1) (cut 85) (env (0 0) (1 30) (35 0)) (release 15) (gain 16) (pan 30))
  (instrument bass (wave soft) (cut 28) (env (0 0) (6 85) (250 55) (900 40)) (release 90) (gain 50))
  (instrument lead (wave bright) (cut 38) (env (0 0) (25 55) (300 42)) (release 260) (gain 24) (pan -15)
    (voice (detune -4)) (voice (detune 4)))
  (instrument arp (wave glass) (env (0 0) (3 40) (180 12)) (release 150) (gain 18) (pan 35))
  (instrument pad (layer calm) (wave organ) (cut 22) (env (0 0) (600 30) (3000 26)) (release 1200) (gain 18)
    (voice (detune -7) (pan -55)) (voice (detune 7) (pan 55)))
  (instrument strings (layer tension) (wave reedy) (cut 30) (env (0 0) (80 50) (1000 40)) (release 300) (gain 20) (pan 20))
  (instrument bell (layer tension) (wave glass) (env (0 0) (3 38) (1400 0)) (release 700) (gain 18) (pan -35))
  (pattern intro
    (bass    "A1 .  .  .  .  .  .  .  F1 .  .  .  .  .  .  .")
    (arp     "A4 C5 E5 C5 A4 C5 E5 C5 F4 A4 C5 A4 F4 A4 C5 A4")
    (hat     ".  .  C4 .  .  .  C4 .  .  .  C4 .  .  .  C4/r2 .")
    (pad     "A3 .  .  .  .  .  .  .  F3 .  .  .  .  .  .  .")
    (pad     "E4 .  .  .  .  .  .  .  C4 .  .  .  .  .  .  ."))
  (pattern verse
    (kick    "C2 .  .  .  .  .  C2 .  C2 .  .  .  .  .  .  .")
    (snare   ".  .  .  .  C4 .  .  .  .  .  .  .  C4 .  .  .")
    (hat     "C4 .  C4/d3 . C4 . C4/d3 . C4 . C4/d3 . C4 . C4/d3 .")
    (bass    "A1 .  A2/c3 A1 . .  E2 .  F1 .  F2/c3 F1 . .  C2 E2/p2")
    (lead    "E5 .  .  D5 C5 .  B4 .  C5 .  .  .  A4/v20,6 . . .")
    (pad     "A3 .  .  .  .  .  .  .  F3 .  .  .  .  .  .  .")
    (pad     "E4 .  .  .  .  .  .  .  C4 .  .  .  .  .  .  .")
    (strings "A3/t40,4 . . . . . . .  F3/t40,4 . . . . . . .")
    (bell    ".  .  .  .  .  .  .  .  .  .  .  .  E5 .  .  ."))
  (pattern turn
    (kick    "C2 .  .  .  .  .  C2 .  C2 .  .  .  .  .  .  .")
    (snare   ".  .  .  .  C4 .  .  .  .  .  .  .  C4 .  .  .")
    (hat     "C4 .  C4/d3 . C4 . C4/d3 . C4 . C4/d3 . C4 . C4/d3 .")
    (bass    "C2 .  C3/c3 C2 . .  G1 .  G1 .  G2/c3 G1 . .  B1 .")
    (lead    "E5 .  G5 .  E5 D5 C5 .  D5 .  .  .  ./v20,6 . . .")
    (pad     "C4 .  .  .  .  .  .  .  B3 .  .  .  .  .  .  .")
    (pad     "E4 .  .  .  .  .  .  .  D4 .  .  .  .  .  .  .")
    (strings "G3/t40,4 . . . . . . .  G3/t40,4 . . . . . . .")
    (bell    ".  .  .  .  G5 .  .  .  .  .  .  .  D5 .  .  ."))
  (pattern fill
    (kick    "C2 .  .  .  .  .  C2 .  C2 .  .  .  .  .  .  .")
    (snare   ".  .  .  .  C4 .  .  .  C4/r3 . . . C4/r2 . C4/r1 .")
    (hat     "C4 .  C4/d3 . C4 . C4/d3 . C4 . C4 .  C4 C4 C4 C4")
    (bass    "C2 .  C3/c3 C2 . .  G1 .  G1 .  G2/c3 G1 G1/s1200 . . .")
    (lead    "E5 .  G5 .  E5 D5 C5 .  B4 .  .  .  .  .  .  -")
    (arp     ".  .  .  .  .  .  .  .  G4/a4,7,12 . . . . . . .")
    (pad     "C4 .  .  .  .  .  .  .  B3 .  .  .  .  .  .  .")
    (pad     "E4 .  .  .  .  .  .  .  D4 .  .  .  .  .  .  .")
    (strings "G3/t40,4 . . . . . . .  G3/t60,2 . . . . . . .")
    (bell    ".  .  .  .  G5 .  .  .  .  .  .  .  D5 .  B5 ."))
  (pattern bridge
    (kick    "C2 .  .  .  C2 .  .  .  C2 .  .  .  C2 .  .  .")
    (snare   ".  .  .  .  C4 .  .  .  .  .  .  .  C4 .  .  .")
    (hat     "C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 .  C4 C4")
    (bass    "D2 .  D2 .  D3/c2 . D2 .  E2 .  E2 .  E3/c2 . G#1 .")
    (arp     "D4/a3,7 . . . D4/a3,7 . . . E4/a4,7 . . . E4/a4,7 . . .")
    (lead    "F5 .  .  .  E5 .  D5 .  E5/v20,6 . . . . . G#4/p4 .")
    (pad     "F3 .  .  .  .  .  .  .  G#3 . .  .  .  .  .  .")
    (pad     "A3 .  .  .  .  .  .  .  B3 .  .  .  .  .  .  .")
    (strings "D4/t50,3 . . . . . . .  E4/t50,3 . . . . . . ."))
  (pattern outro
    (kick    "C2 .  .  .  .  .  .  .  .  .  .  .  .  .  .  .")
    (bass    "A1/l30 . . . . . . . . . . . . . . -")
    (arp     "A4 C5 E5 A5 E5 C5 A4 E4 A4:70/f30 . . . . . . -")
    (lead    "A4/v15,8 . . . . . . . ./f0 . . . . . . .")
    (pad     "A3/f0 . . . . . . . . . . . . . . .")
    (pad     "E4/f0 . . . . . . . . . . . . . . .")
    (pad     "C4:80/f0 . . . . . . . . . . . . . . ."))
  (order intro verse turn verse fill bridge verse turn outro))
